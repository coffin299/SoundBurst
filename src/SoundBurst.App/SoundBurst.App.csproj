<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>SoundBurst</AssemblyName>
    <RootNamespace>SoundBurst.App</RootNamespace>
    <Version>0.1.0</Version>
    <Product>SoundBurst</Product>
    <Authors>SoundBurst Contributors</Authors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>SoundBurst.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SoundBurst.Core\SoundBurst.Core.csproj" />
    <ProjectReference Include="..\SoundBurst.Audio\SoundBurst.Audio.csproj" />
  </ItemGroup>
</Project>
