<Window x:Class="SoundBurst.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SoundBurst"
        Height="760" Width="980"
        MinHeight="600" MinWidth="800"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}">
  <ScrollViewer Padding="20">
    <StackPanel MaxWidth="920">
      <TextBlock Text="SoundBurst" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,4"/>
      <TextBlock Text="マイクとサウンドボードをミックスして仮想マイクへ出力"
                 Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

      <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock x:Name="DriverStatusText" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <StackPanel Orientation="Horizontal">
            <Button Content="状態を再確認" Click="RefreshDriver_Click" Margin="0,0,8,0" Padding="10,4"/>
            <Button Content="セットアップ手順" Click="ShowSetup_Click" Padding="10,4"/>
          </StackPanel>
          <TextBlock x:Name="SetupText" Visibility="Collapsed" Margin="0,10,0,0" TextWrapping="Wrap"
                     Foreground="{StaticResource MutedBrush}"
                     Text="1) Test Mode を有効化し SoundBurst 仮想ドライバをインストール&#x0a;2) このアプリでミックス開始&#x0a;3) Discord の入力を「SoundBurst Microphone」に設定&#x0a;4) Discord のノイズ抑制をオフにすると SE が消えにくいです"/>
        </StackPanel>
      </Border>

      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="マイク" VerticalAlignment="Center" Margin="0,4"/>
        <ComboBox x:Name="MicCombo" Grid.Column="1" Margin="0,4" DisplayMemberPath="Name" SelectionChanged="DeviceChanged"/>

        <TextBlock Grid.Row="1" Text="仮想出力" VerticalAlignment="Center" Margin="0,4"/>
        <ComboBox x:Name="VirtualOutCombo" Grid.Row="1" Grid.Column="1" Margin="0,4" DisplayMemberPath="Name" SelectionChanged="DeviceChanged"/>

        <TextBlock Grid.Row="2" Text="モニター" VerticalAlignment="Center" Margin="0,4"/>
        <ComboBox x:Name="MonitorCombo" Grid.Row="2" Grid.Column="1" Margin="0,4" DisplayMemberPath="Name" SelectionChanged="DeviceChanged"/>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
          <Button x:Name="StartStopButton" Content="ミックス開始" Click="StartStop_Click" Padding="14,6" Margin="0,0,12,0"
                  Background="{StaticResource AccentBrush}" Foreground="#111" FontWeight="SemiBold" BorderThickness="0"/>
          <CheckBox x:Name="MonitorToggle" Content="モニターON" VerticalAlignment="Center" Checked="MonitorToggle_Changed" Unchecked="MonitorToggle_Changed"/>
          <TextBlock x:Name="EngineStatusText" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
      </Grid>

      <TextBlock Text="レベル" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="50"/><ColumnDefinition Width="*"/>
          <ColumnDefinition Width="50"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Mic" VerticalAlignment="Center"/>
        <ProgressBar x:Name="MicLevelBar" Grid.Column="1" Height="10" Maximum="1" Margin="0,0,12,0"/>
        <TextBlock Grid.Column="2" Text="Mix" VerticalAlignment="Center"/>
        <ProgressBar x:Name="MixLevelBar" Grid.Column="3" Height="10" Maximum="1"/>
      </Grid>

      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,8,0">
          <TextBlock Text="マイク音量"/>
          <Slider x:Name="MicVolumeSlider" Minimum="0" Maximum="2" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="MicVolume_Changed"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,8,0">
          <TextBlock Text="モニター音量"/>
          <Slider x:Name="MonitorVolumeSlider" Minimum="0" Maximum="2" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="MonitorVolume_Changed"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="SEマスター"/>
          <Slider x:Name="ClipMasterSlider" Minimum="0" Maximum="2" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="ClipMaster_Changed"/>
        </StackPanel>
      </Grid>

      <DockPanel Margin="0,0,0,8">
        <Button DockPanel.Dock="Right" Content="音声を追加" Click="AddClip_Click" Padding="10,4"/>
        <TextBlock Text="サウンドボード" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>

      <ListView x:Name="ClipList" MinHeight="180" Background="{StaticResource PanelBrush}" BorderThickness="0">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="名前" Width="180" DisplayMemberBinding="{Binding Name}"/>
            <GridViewColumn Header="ホットキー" Width="120" DisplayMemberBinding="{Binding Hotkey}"/>
            <GridViewColumn Header="ファイル" Width="320" DisplayMemberBinding="{Binding FilePath}"/>
            <GridViewColumn Header="" Width="220">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Button Content="再生" Tag="{Binding}" Click="PlayClip_Click" Margin="0,0,4,0" Padding="8,2"/>
                    <Button Content="停止" Tag="{Binding}" Click="StopClip_Click" Margin="0,0,4,0" Padding="8,2"/>
                    <Button Content="削除" Tag="{Binding}" Click="DeleteClip_Click" Padding="8,2"/>
                  </StackPanel>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView>
        </ListView.View>
      </ListView>
      <TextBlock Text="ホットキー例: Ctrl+Shift+1 / F8（追加ダイアログで指定）"
                 Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,16"/>

      <TextBlock Text="更新" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
        <Button Content="更新を確認" Click="CheckUpdate_Click" Padding="10,4" Margin="0,0,8,0"/>
        <Button x:Name="ApplyUpdateButton" Content="ダウンロードして適用" Click="ApplyUpdate_Click" IsEnabled="False" Padding="10,4" Margin="0,0,8,0"/>
        <TextBlock x:Name="UpdateStatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
